node_modules/
.env
*.log
.cline/

# ---- Environment / secrets ----
# The real configuration lives in server/.env and is intentionally NOT tracked.
# Only the local file is used (dotenv loads it); deployments supply their own
# environment variables through the host (Railway), never via git.
.env
.env.*
server/.env
server/.env.*

# Runtime files ----
# Uploaded avatars now live in the database and are served by /api/avatar/:phone.
# Committing them is pointless (and previously committed a 24-byte HTML error page
# as a ".jpg"); the container filesystem is ephemeral anyway.
uploads/avatars/*
!uploads/avatars/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs ----
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Temporary files & caches ----
.cache/
.tmp/
.temp/
*.tmp
*.temp

# ---- OS metadata ----
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editor swap / backup files ----
*~
*.swp
*.swo
*.bak
*.old
*.orig
*.backup

# ---- Build output (regenerated by `npm run build`) ----
dist/
build/
site/

# ---- Runtime backups ----
server/backups/

